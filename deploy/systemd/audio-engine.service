[Unit]
Description=Multi-Effect Amp Modeler - audio engine
Documentation=file://__REPO_DIR__/audio-engine/README.md
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__REPO_DIR__/audio-engine
RuntimeDirectory=multieffect-amp-modeler
RuntimeDirectoryMode=0770
ExecStart=__REPO_DIR__/audio-engine/build/audio_engine /run/multieffect-amp-modeler/audio-engine.sock
Restart=on-failure
RestartSec=2

# Hardening. The engine only ever READS uploaded .nam/IR files (never
# writes into __DATA_DIR__ -- the control daemon owns writing there), so
# this gets ReadOnlyPaths rather than control-daemon's ReadWritePaths.
# ProtectHome=true (rather than "read-only") would make /home -- and this
# checkout, if it lives under a user's home directory as deploy/README.md's
# own "git clone" step puts it -- entirely invisible to this service, not
# just unwritable: WorkingDirectory/ExecStart above would fail to resolve
# at all (systemd status=203/EXEC), not merely refuse to write. "read-only"
# still denies writes under /home, which is all the hardening intent here
# actually needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=__DATA_DIR__
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
