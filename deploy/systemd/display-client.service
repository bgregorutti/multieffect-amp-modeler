[Unit]
Description=Multi-Effect Amp Modeler - onboard display (read-only)
Documentation=file://__REPO_DIR__/display-client/README.md
# Started first and therefore stopped last (systemd stops in reverse start
# order): it draws the boot progress bar while the engine and the daemon
# come up, and the "shutting down" frame while they go down (spec section
# 5.4). Before= is ordering only -- this unit is Type=simple, so the other
# two start as soon as this process is forked, not after it's drawn
# anything, and neither of them depends on a screen being present.
Before=multieffect-audio-engine.service multieffect-control-daemon.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__REPO_DIR__/display-client
Environment=DISPLAY_CLIENT_URI=ws://127.0.0.1:8765/ws
# auto = the first framebuffer that isn't HDMI (the SPI panel is /dev/fb1
# next to the vc4-kms HDMI fb0 on stock Raspberry Pi OS). Pin it with e.g.
# DISPLAY_CLIENT_OUTPUT=/dev/fb1 if detection picks the wrong one.
Environment=DISPLAY_CLIENT_OUTPUT=auto
# Logical resolution, filled in by install.sh (--lcd-size). Empty = use the
# framebuffer's own size. Switching between the 3.5" 480x320 and the 2.8"
# 320x240 panel is a config change only (spec section 4.4).
Environment=DISPLAY_CLIENT_WIDTH=__LCD_WIDTH__
Environment=DISPLAY_CLIENT_HEIGHT=__LCD_HEIGHT__
Environment=DISPLAY_CLIENT_ROTATE=__LCD_ROTATE__
# Take the Linux text console off every framebuffer before drawing, or
# boot messages, the getty login prompt and the cursor keep drawing on top
# of the panel. Unbinding fbcon (rather than putting the VT in graphics
# mode) is the only thing that sticks: getty@tty1 resets its terminal to
# text mode when it starts (TTYReset=yes). "+" runs this one line as root,
# outside the sandbox below. It also blanks the HDMI console, which a
# headless pedal doesn't use -- SSH in instead. Not undone on stop: at
# shutdown the console would otherwise draw over the "shutting down" frame.
# To get it back by hand: echo 1 | sudo tee /sys/class/vtconsole/vtcon1/bind
ExecStartPre=+/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" "$$v/name" && echo 0 > "$$v/bind"; done; true'
ExecStart=__REPO_DIR__/display-client/.venv/bin/display-client
Restart=on-failure
RestartSec=1

# Spec section 4.4: never on the audio engine's cores. audio-engine.service
# is pinned to CPUs 1-3, so rendering (and its SPI writes) stay on CPU 0,
# at low priority on top.
CPUAffinity=0
Nice=10

# /dev/fb* is group 'video'. PrivateDevices= deliberately NOT set: it would
# hide the framebuffer.
SupplementaryGroups=video
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
