# Copy this file to deploy/config.env and edit it, then run
# `sudo ./deploy/install.sh` with no flags -- it's sourced automatically.
# deploy/config.env is gitignored (it can hold a Wi-Fi password) so it's
# safe to keep it local to each pedal's checkout.
#
# Anything set here can still be overridden by a CLI flag, e.g.
# `sudo ./deploy/install.sh --ssid SomethingElse`.

WIFI_SSID="MultiEffectPedal"

# Leave empty to have install.sh generate and print a random one.
WIFI_PASSWORD=""

# Required for the Wi-Fi radio to legally transmit. Two-letter ISO code,
# e.g. FR, US, DE, GB.
WIFI_COUNTRY=""

# Usually correct on a Pi with only onboard Wi-Fi; change if you're using a
# USB Wi-Fi adapter instead.
WIFI_IFACE="wlan0"

# NetworkManager profile for your *client* Wi-Fi network (the home/dev
# network with internet). Once the pedal's AP owns the radio, the Pi has no
# uplink, so install.sh borrows the radio for this network while it installs
# packages, then hands it straight back. Leave empty to auto-detect any
# Wi-Fi profile that isn't the AP's -- set it explicitly if the Pi knows
# several. `nmcli connection show` lists the names.
CLIENT_WIFI=""

# Substring of the audio interface's name the engine captures and plays
# through -- e.g. "Scarlett", "USB Audio". Matched case-insensitively
# against a device that actually has the channels needed, so it keeps
# working when USB card numbers shuffle between boots (a card index would
# not, and this pedal gets power-cut rather than shut down).
#
# Leave empty ONLY on a machine whose default audio device is the one you
# want. On a Pi that is the onboard bcm2835, which has no capture side at
# all, so the engine will fail to open an input and log the available
# devices. List them yourself with:
#   audio-engine/build/audio_engine --list-devices
AUDIO_DEVICE=""

# System user both services run as.
SERVICE_USER="ampmodeler"
