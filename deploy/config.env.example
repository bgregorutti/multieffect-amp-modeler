# Copy this file to deploy/config.env and edit it, then run
# `sudo ./deploy/install.sh` with no flags -- it's sourced automatically.
# deploy/config.env is gitignored (it can hold a Wi-Fi password) so it's
# safe to keep it local to each pedal's checkout.
#
# Anything set here can still be overridden by a CLI flag, e.g.
# `sudo ./deploy/install.sh --ssid SomethingElse`.

WIFI_SSID="MultiEffectPedal"

# Leave empty to have install.sh generate and print a random one.
WIFI_PASSWORD=""

# Required for the Wi-Fi radio to legally transmit. Two-letter ISO code,
# e.g. FR, US, DE, GB.
WIFI_COUNTRY=""

# Usually correct on a Pi with only onboard Wi-Fi; change if you're using a
# USB Wi-Fi adapter instead.
WIFI_IFACE="wlan0"

# System user both services run as.
SERVICE_USER="ampmodeler"
